DATABASE_URL="file:./dev.db"
# Senha para acessar o app pelo celular (altere para uma senha forte)
APP_PASSWORD="troque-esta-senha"
# Segredo HMAC para assinar cookies de sessão (use 32+ caracteres aleatórios)
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-64-caracteres"
# Caminho para o binário do Antigravity CLI (agy)
AGY_BIN="/usr/bin/agy"
# Pasta raiz dos seus projetos/repositórios locais
WORKSPACES_ROOT="/path/to/your/repos"
# Pasta onde áudios e fotos enviados pelo celular são salvos
UPLOADS_DIR="./data/uploads"
